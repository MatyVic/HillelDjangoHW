# Copy this file to `.env` (or `.env_local` for local venv work) and fill in
# real values. Never commit the filled-in version - only this .env.example
# with placeholders belongs in git.

# --- Core ---
DJANGO_SECRET_KEY=change-me
# Comma-separated list, production only, e.g.:
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=
# Comma-separated list, production only, e.g.:
# CORS_ALLOWED_ORIGINS=https://example.com,https://sub.example.com
CORS_ALLOWED_ORIGINS=

# --- Database (PostgreSQL) ---
DB_NAME=db
DB_USER=my_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Email (production only - console backend is used in development) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=

# --- Uvicorn (local `python run_server.py` only) ---
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
